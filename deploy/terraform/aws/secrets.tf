# Secrets Aspen needs besides the database password (database.tf): the keys
# that sign express and CDN URLs, and the SSH host key. Both are generated by
# ephemeral resources and written with write-only attributes, so they never
# land in Terraform state or plan files. Each is written once, and again only
# when its *_version variable changes.

# ---------------------------------------------------------------------------
# Express keys (ASPEN_EXPRESS_KEYS): `k<version>:<64 hex digits>`
# ---------------------------------------------------------------------------

ephemeral "random_password" "express_key" {
  count = var.enable_express ? 1 : 0

  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "express_keys" {
  count = var.enable_express ? 1 : 0

  name_prefix             = "${var.name}-express-keys-"
  description             = "ASPEN_EXPRESS_KEYS for ${var.name}: signs and verifies express and CDN pack URLs."
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "express_keys" {
  count = var.enable_express ? 1 : 0

  secret_id = aws_secretsmanager_secret.express_keys[0].id
  # Aspen wants `id:hexsecret` with at least 32 bytes of secret. SHA-256 of
  # 48 random alphanumerics (about 285 bits) gives exactly 32 bytes in hex.
  # The key ID follows the version, so a rotated key never reuses an ID.
  secret_string_wo         = "k${var.express_keys_version}:${sha256(ephemeral.random_password.express_key[0].result)}"
  secret_string_wo_version = var.express_keys_version
}

# ---------------------------------------------------------------------------
# SSH host key (ASPEN_SSH_HOST_KEY)
#
# Clients pin the host key, so it is generated once and is the same on every
# task. Its public half goes to an SSM parameter (not secret), so operators
# can publish the known_hosts line without reading the private key.
# ---------------------------------------------------------------------------

ephemeral "tls_private_key" "ssh_host" {
  count = var.enable_ssh ? 1 : 0

  algorithm = "ED25519"
}

resource "aws_secretsmanager_secret" "ssh_host_key" {
  count = var.enable_ssh ? 1 : 0

  name_prefix             = "${var.name}-ssh-host-key-"
  description             = "Ed25519 SSH host key of ${var.name} (ASPEN_SSH_HOST_KEY). Clients pin it: rotating it breaks their known_hosts."
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "ssh_host_key" {
  count = var.enable_ssh ? 1 : 0

  secret_id                = aws_secretsmanager_secret.ssh_host_key[0].id
  secret_string_wo         = ephemeral.tls_private_key.ssh_host[0].private_key_openssh
  secret_string_wo_version = var.ssh_host_key_version
}

resource "aws_ssm_parameter" "ssh_host_public_key" {
  count = var.enable_ssh ? 1 : 0

  name        = "/${var.name}/ssh-host-public-key"
  description = "Public half of the ${var.name} SSH host key, for known_hosts."
  type        = "String"
  # Written in the same run as the private key above, from the same key.
  value_wo         = trimspace(ephemeral.tls_private_key.ssh_host[0].public_key_openssh)
  value_wo_version = var.ssh_host_key_version
}
