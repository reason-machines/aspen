# The place demo (demo/place, plan nodes A9 and C7) at place.<base_domain>:
# one aspen-place task that serves the page, its API (/api/v1) and the
# canvas repository (/canvas.git), behind the module's ALB by host name.
#
# aspen-place is its own Git server with its own repository rules, so it
# gets its own database (`place`, on the module's RDS instance), its own
# login role (`place`, which owns that database and nothing else) and its own
# bucket: Aspen's server at git.<base_domain> never sees the canvas, a push
# there could never skip the tile rules, and the internet-facing demo never
# holds the RDS master credentials or reaches Aspen's database. Only the
# non-essential init container that creates the role and database
# (create-database.sh) gets the master password.
#
# It keeps the canvas, the merge queue and the event feed in memory and
# must run as exactly one instance, never two at once, also not during a
# deploy (demo/place/server/README.md, "Limits of this version"). So the
# service stops the old task before it starts the new one, and on SIGTERM
# aspen-place runs its last merge before exiting.

locals {
  place = var.place_image != null

  canvas_mirror = local.place && var.place_canvas_mirror != null

  place_database_user = "place"

  place_url = "https://${local.place_host}"

  place_environment = merge({
    PLACE_LISTEN             = "0.0.0.0:${var.place_port}"
    PLACE_DATABASE_URL       = "postgres://${local.place_database_user}@${module.aspen.database_address}:${module.aspen.database_port}/place?sslmode=require"
    PLACE_BLOB_URL           = local.place ? "s3://${aws_s3_bucket.place[0].id}" : ""
    AWS_REGION               = var.region
    PLACE_DOMAIN             = var.base_domain
    PLACE_CLONE_URL          = "${local.place_url}/canvas.git"
    PLACE_DASHBOARD_URL      = var.place_dashboard_url
    PLACE_TRUSTED_PROXY_HOPS = "1"
    PLACE_DB_MAX_CONNECTIONS = tostring(local.place_db_max_connections)
    PLACE_MIRROR_URL         = var.place_canvas_mirror == null ? "" : "https://github.com/${var.place_canvas_mirror}"
  }, var.place_environment)
}

# ---------------------------------------------------------------------------
# Storage: a bucket of its own, private to the place task
# ---------------------------------------------------------------------------

resource "aws_s3_bucket" "place" {
  count = local.place ? 1 : 0

  bucket_prefix = "${local.name}-place-"
  force_destroy = var.bucket_force_destroy
}

resource "aws_s3_bucket_ownership_controls" "place" {
  count  = local.place ? 1 : 0
  bucket = aws_s3_bucket.place[0].id

  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_public_access_block" "place" {
  count  = local.place ? 1 : 0
  bucket = aws_s3_bucket.place[0].id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "place" {
  count  = local.place ? 1 : 0
  bucket = aws_s3_bucket.place[0].id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "place" {
  count  = local.place ? 1 : 0
  bucket = aws_s3_bucket.place[0].id

  rule {
    id     = "abort-incomplete-multipart-uploads"
    status = "Enabled"
    filter {}

    abort_incomplete_multipart_upload {
      days_after_initiation = 1
    }
  }
}

data "aws_iam_policy_document" "place_bucket" {
  count = local.place ? 1 : 0

  statement {
    sid       = "DenyInsecureTransport"
    effect    = "Deny"
    actions   = ["s3:*"]
    resources = [aws_s3_bucket.place[0].arn, "${aws_s3_bucket.place[0].arn}/*"]

    principals {
      type        = "*"
      identifiers = ["*"]
    }

    condition {
      test     = "Bool"
      variable = "aws:SecureTransport"
      values   = ["false"]
    }
  }
}

resource "aws_s3_bucket_policy" "place" {
  count  = local.place ? 1 : 0
  bucket = aws_s3_bucket.place[0].id
  policy = data.aws_iam_policy_document.place_bucket[0].json

  depends_on = [aws_s3_bucket_public_access_block.place]
}

# ---------------------------------------------------------------------------
# Database login: generated by an ephemeral resource and written with
# write-only attributes, so it never lands in Terraform state or plan files.
# To rotate it, bump place_db_password_version, apply, then force a new
# deployment of the place service (create-database.sh sets the new password
# before aspen-place starts).
# ---------------------------------------------------------------------------

ephemeral "random_password" "place_db" {
  count = local.place ? 1 : 0

  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "place_db_password" {
  count = local.place ? 1 : 0

  name_prefix             = "${local.name}-place-db-password-"
  description             = "Password of the `place` database role of ${local.name} (PGPASSWORD for aspen-place)."
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "place_db_password" {
  count = local.place ? 1 : 0

  secret_id                = aws_secretsmanager_secret.place_db_password[0].id
  secret_string_wo         = ephemeral.random_password.place_db[0].result
  secret_string_wo_version = var.place_db_password_version
}

# The canvas mirror's credential: an SSH deploy key (private half, OpenSSH
# format) or a token with write access to that one repository. Terraform
# creates the secret only; the value goes in by hand and never into state
# (../README.md, "Mirror the canvas to GitHub").
resource "aws_secretsmanager_secret" "place_canvas_mirror_key" {
  count = local.canvas_mirror ? 1 : 0

  name_prefix             = "${local.name}-place-canvas-mirror-key-"
  description             = "SSH deploy key (private half) or token with write access to github.com/${var.place_canvas_mirror} only, for the canvas mirror sidecar of ${local.name}."
  recovery_window_in_days = 7
}

# ---------------------------------------------------------------------------
# Logs and IAM
# ---------------------------------------------------------------------------

resource "aws_cloudwatch_log_group" "place" {
  count = local.place ? 1 : 0

  name              = "/aspen/${local.name}/place"
  retention_in_days = 14
}

data "aws_iam_policy_document" "place_assume" {
  statement {
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["ecs-tasks.amazonaws.com"]
    }

    condition {
      test     = "StringEquals"
      variable = "aws:SourceAccount"
      values   = [var.aws_account_id]
    }
  }
}

resource "aws_iam_role" "place_execution" {
  count = local.place ? 1 : 0

  name_prefix        = "${local.name}-place-exec-"
  assume_role_policy = data.aws_iam_policy_document.place_assume.json
}

data "aws_iam_policy_document" "place_execution" {
  count = local.place ? 1 : 0

  statement {
    sid       = "WriteLogs"
    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
    resources = ["${aws_cloudwatch_log_group.place[0].arn}:*"]
  }

  # The master password goes only to the create-database init container;
  # the place container gets its own role's password.
  statement {
    sid       = "ReadDatabasePasswords"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [module.aspen.database_password_secret_arn, aws_secretsmanager_secret.place_db_password[0].arn]
  }

  dynamic "statement" {
    for_each = local.canvas_mirror ? [1] : []

    content {
      sid       = "ReadCanvasMirrorCredential"
      actions   = ["secretsmanager:GetSecretValue"]
      resources = [aws_secretsmanager_secret.place_canvas_mirror_key[0].arn]
    }
  }

  dynamic "statement" {
    for_each = length(var.ecr_repository_arns) > 0 ? [1] : []

    content {
      sid       = "PullImage"
      actions   = ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"]
      resources = var.ecr_repository_arns
    }
  }

  dynamic "statement" {
    for_each = length(var.ecr_repository_arns) > 0 ? [1] : []

    content {
      sid       = "EcrAuth"
      actions   = ["ecr:GetAuthorizationToken"]
      resources = ["*"] # no resource-level permissions for this action
    }
  }
}

resource "aws_iam_role_policy" "place_execution" {
  count = local.place ? 1 : 0

  name   = "place-execution"
  role   = aws_iam_role.place_execution[0].id
  policy = data.aws_iam_policy_document.place_execution[0].json
}

# What aspen-place may do: objects in its own bucket, and ECS Exec channels
# (operators issue kill-switch tokens with `aspen-place operator-token`).
resource "aws_iam_role" "place_task" {
  count = local.place ? 1 : 0

  name_prefix        = "${local.name}-place-task-"
  assume_role_policy = data.aws_iam_policy_document.place_assume.json
}

data "aws_iam_policy_document" "place_task" {
  count = local.place ? 1 : 0

  statement {
    sid       = "PlaceBucket"
    actions   = ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketMultipartUploads"]
    resources = [aws_s3_bucket.place[0].arn]
  }

  statement {
    sid = "PlaceObjects"
    actions = [
      "s3:GetObject",
      "s3:PutObject",
      "s3:DeleteObject",
      "s3:AbortMultipartUpload",
      "s3:ListMultipartUploadParts",
    ]
    resources = ["${aws_s3_bucket.place[0].arn}/*"]
  }

  statement {
    sid = "EcsExec"
    actions = [
      "ssmmessages:CreateControlChannel",
      "ssmmessages:CreateDataChannel",
      "ssmmessages:OpenControlChannel",
      "ssmmessages:OpenDataChannel",
    ]
    resources = ["*"] # no resource-level permissions for these actions
  }
}

resource "aws_iam_role_policy" "place_task" {
  count = local.place ? 1 : 0

  name   = "place-task"
  role   = aws_iam_role.place_task[0].id
  policy = data.aws_iam_policy_document.place_task[0].json
}

# ---------------------------------------------------------------------------
# Network: in from the ALB only; out to HTTPS (S3, ECR, logs) and the
# database
# ---------------------------------------------------------------------------

resource "aws_security_group" "place" {
  count = local.place ? 1 : 0

  name_prefix = "${local.name}-place-"
  description = "place demo tasks"
  vpc_id      = module.aspen.vpc_id
  tags        = { Name = "${local.name}-place" }

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_vpc_security_group_ingress_rule" "place_from_alb" {
  count = local.place ? 1 : 0

  security_group_id            = aws_security_group.place[0].id
  description                  = "place over HTTP from the ALB"
  ip_protocol                  = "tcp"
  from_port                    = var.place_port
  to_port                      = var.place_port
  referenced_security_group_id = module.aspen.alb_security_group_id
}

resource "aws_vpc_security_group_egress_rule" "alb_to_place" {
  count = local.place ? 1 : 0

  security_group_id            = module.aspen.alb_security_group_id
  description                  = "To place tasks"
  ip_protocol                  = "tcp"
  from_port                    = var.place_port
  to_port                      = var.place_port
  referenced_security_group_id = aws_security_group.place[0].id
}

resource "aws_vpc_security_group_egress_rule" "place_https" {
  count = local.place ? 1 : 0

  security_group_id = aws_security_group.place[0].id
  description       = "HTTPS to AWS APIs (S3, ECR, CloudWatch, SSM)"
  ip_protocol       = "tcp"
  from_port         = 443
  to_port           = 443
  cidr_ipv4         = "0.0.0.0/0"
}

resource "aws_vpc_security_group_egress_rule" "place_to_db" {
  count = local.place ? 1 : 0

  security_group_id            = aws_security_group.place[0].id
  description                  = "PostgreSQL"
  ip_protocol                  = "tcp"
  from_port                    = 5432
  to_port                      = 5432
  referenced_security_group_id = module.aspen.database_security_group_id
}

resource "aws_vpc_security_group_ingress_rule" "db_from_place" {
  count = local.place ? 1 : 0

  security_group_id            = module.aspen.database_security_group_id
  description                  = "PostgreSQL from place tasks"
  ip_protocol                  = "tcp"
  from_port                    = 5432
  to_port                      = 5432
  referenced_security_group_id = aws_security_group.place[0].id
}

# ---------------------------------------------------------------------------
# HTTPS: a certificate for place.<base_domain> on the module's ALB, and a
# host rule that sends its requests to the place task
# ---------------------------------------------------------------------------

resource "aws_acm_certificate" "place" {
  count = local.place ? 1 : 0

  domain_name       = local.place_host
  validation_method = "DNS"

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_route53_record" "place_validation" {
  # Keyed by the hostname, which is known at plan time.
  for_each = local.place ? toset([local.place_host]) : toset([])

  zone_id = var.route53_zone_id
  name    = local.place_validation[each.key].resource_record_name
  type    = local.place_validation[each.key].resource_record_type
  records = [local.place_validation[each.key].resource_record_value]
  ttl     = 300
}

locals {
  place_validation = local.place ? {
    for o in aws_acm_certificate.place[0].domain_validation_options : o.domain_name => o
  } : {}
}

resource "aws_acm_certificate_validation" "place" {
  count = local.place ? 1 : 0

  certificate_arn         = aws_acm_certificate.place[0].arn
  validation_record_fqdns = [for r in aws_route53_record.place_validation : r.fqdn]
}

resource "aws_lb_listener_certificate" "place" {
  count = local.place ? 1 : 0

  listener_arn    = module.aspen.https_listener_arn
  certificate_arn = aws_acm_certificate_validation.place[0].certificate_arn
}

resource "aws_lb_target_group" "place" {
  count = local.place ? 1 : 0

  name_prefix = "place-"
  target_type = "ip"
  vpc_id      = module.aspen.vpc_id
  protocol    = "HTTP"
  port        = var.place_port

  # Short: the old task must be gone before the new one starts, and every
  # second here is a second the demo is down during a deploy.
  deregistration_delay = 15

  health_check {
    path                = "/api/v1/config"
    matcher             = "200"
    interval            = 15
    timeout             = 5
    healthy_threshold   = 2
    unhealthy_threshold = 3
  }

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_lb_listener_rule" "place" {
  count = local.place ? 1 : 0

  listener_arn = module.aspen.https_listener_arn
  priority     = var.place_listener_rule_priority

  condition {
    host_header {
      values = [local.place_host]
    }
  }

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.place[0].arn
  }
}

resource "aws_route53_record" "place" {
  count = local.place ? 1 : 0

  zone_id = var.route53_zone_id
  name    = local.place_host
  type    = "A"

  alias {
    name                   = module.aspen.alb_dns_name
    zone_id                = module.aspen.alb_zone_id
    evaluate_target_health = true
  }
}

# ---------------------------------------------------------------------------
# The task and the service
# ---------------------------------------------------------------------------

locals {
  # As the RDS master user: creates or updates the `place` role and
  # database and locks both databases down (create-database.sh). The place
  # container starts only once this exits 0. It is the only container that
  # gets the master password.
  create_database = {
    name      = "create-database"
    image     = var.place_database_init_image
    essential = false
    user      = "70:70" # postgres in the Alpine image, not root
    command   = ["sh", "-c", file("${path.module}/create-database.sh")]
    environment = [
      { name = "ASPEN_DATABASE", value = module.aspen.database_name },
      { name = "PGDATABASE", value = module.aspen.database_name },
      { name = "PGHOST", value = module.aspen.database_address },
      { name = "PGPORT", value = tostring(module.aspen.database_port) },
      { name = "PGSSLMODE", value = "require" },
      { name = "PGUSER", value = module.aspen.database_username },
    ]
    secrets = [
      { name = "PGPASSWORD", valueFrom = module.aspen.database_password_secret_arn },
      { name = "PLACE_PASSWORD", valueFrom = local.place ? aws_secretsmanager_secret.place_db_password[0].arn : "" },
    ]
    logConfiguration = {
      logDriver = "awslogs"
      options = {
        awslogs-group         = local.place ? aws_cloudwatch_log_group.place[0].name : ""
        awslogs-region        = var.region
        awslogs-stream-prefix = "create-database"
      }
    }
  }

  place_container = {
    name      = "place"
    image     = var.place_image
    essential = true
    dependsOn = [{ containerName = "create-database", condition = "SUCCESS" }]

    portMappings = [{ name = "http", containerPort = var.place_port, protocol = "tcp" }]

    environment = [
      for k in sort(keys(local.place_environment)) : { name = k, value = local.place_environment[k] }
      if local.place_environment[k] != ""
    ]
    # The `place` role's password only, never the master's.
    secrets = [{ name = "PGPASSWORD", valueFrom = local.place ? aws_secretsmanager_secret.place_db_password[0].arn : "" }]

    linuxParameters = { initProcessEnabled = true }
    # Fargate's maximum: the drain (PLACE_SHUTDOWN_DRAIN_SECONDS, 20 s) plus
    # the last merge fit well inside it.
    stopTimeout = 120

    logConfiguration = {
      logDriver = "awslogs"
      options = {
        awslogs-group         = local.place ? aws_cloudwatch_log_group.place[0].name : ""
        awslogs-region        = var.region
        awslogs-stream-prefix = "place"
        mode                  = "non-blocking"
        max-buffer-size       = "4m"
      }
    }
  }
}

locals {
  # Keeps github.com/<place_canvas_mirror>'s main a copy of the canvas's
  # main (canvas-mirror.sh). Not essential: when GitHub or the key fails,
  # place keeps serving and the sidecar's log says why.
  canvas_mirror_container = {
    name      = "canvas-mirror"
    image     = var.place_canvas_mirror_image
    essential = false
    dependsOn = [{ containerName = "place", condition = "START" }]
    command   = ["sh", "-c", file("${path.module}/canvas-mirror.sh")]
    environment = [
      { name = "MIRROR_REPO", value = coalesce(var.place_canvas_mirror, "-") },
      { name = "MIRROR_SOURCE", value = "http://127.0.0.1:${var.place_port}/canvas.git" },
      { name = "MIRROR_INTERVAL", value = tostring(var.place_canvas_mirror_interval_seconds) },
    ]
    secrets = [{ name = "MIRROR_CREDENTIAL", valueFrom = local.canvas_mirror ? aws_secretsmanager_secret.place_canvas_mirror_key[0].arn : "" }]
    logConfiguration = {
      logDriver = "awslogs"
      options = {
        awslogs-group         = local.place ? aws_cloudwatch_log_group.place[0].name : ""
        awslogs-region        = var.region
        awslogs-stream-prefix = "canvas-mirror"
      }
    }
  }
}

resource "aws_ecs_task_definition" "place" {
  count = local.place ? 1 : 0

  family                   = "${local.name}-place"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = local.place_cpu
  memory                   = local.place_memory
  execution_role_arn       = aws_iam_role.place_execution[0].arn
  task_role_arn            = aws_iam_role.place_task[0].arn

  runtime_platform {
    operating_system_family = "LINUX"
    cpu_architecture        = "X86_64"
  }

  container_definitions = jsonencode(concat(
    [local.create_database, local.place_container],
    local.canvas_mirror ? [local.canvas_mirror_container] : [],
  ))
}

resource "aws_ecs_service" "place" {
  count = local.place ? 1 : 0

  name            = "${local.name}-place"
  cluster         = module.aspen.ecs_cluster_arn
  task_definition = aws_ecs_task_definition.place[0].arn
  desired_count   = var.place_running ? 1 : 0

  # Never Spot: an interruption is a crash, and a crash loses the pushes
  # accepted since the last merge (#55).
  launch_type = "FARGATE"

  network_configuration {
    subnets          = module.aspen.task_subnet_ids
    security_groups  = [aws_security_group.place[0].id]
    assign_public_ip = module.aspen.tasks_have_public_ip
  }

  load_balancer {
    target_group_arn = aws_lb_target_group.place[0].arn
    container_name   = "place"
    container_port   = var.place_port
  }

  # Exactly one instance, never two: stop the old task, then start the new.
  deployment_minimum_healthy_percent = 0
  deployment_maximum_percent         = 100
  health_check_grace_period_seconds  = 60
  enable_execute_command             = true
  enable_ecs_managed_tags            = true
  propagate_tags                     = "SERVICE"

  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  depends_on = [aws_lb_listener_rule.place, aws_iam_role_policy.place_execution, aws_secretsmanager_secret_version.place_db_password]
}
