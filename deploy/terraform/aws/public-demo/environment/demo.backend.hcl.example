# Remote state for the demo environment. Copy to demo.backend.hcl (ignored by
# git) and run `terraform init -reconfigure -backend-config=demo.backend.hcl`.

bucket       = "REPLACE-ME-aspen-tfstate"
key          = "public-demo/demo/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
